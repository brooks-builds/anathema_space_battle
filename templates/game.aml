vstack
	hstack
		text "game id: "
		text state.id
	hstack
		text "game size: "
		text state.width
		text " x "
		text state.height
	hstack
		text "Player token: "
		text attributes.player_token
	hstack
		border [width: state.width + 1, height: state.height]
			canvas
		vstack
			@BBHeading [text: "Your Ship", padding_top: 1, padding_bottom: 1]
			for player_id in state.player_ids
				if player_id == attributes.player_id
					vstack
						if player_id == state.host_id
							text "Hosting"
						if state.players_ready[loop]
							text [foreground: "green"] "ready"
						else
							text [foreground: "red"] "Complete actions to take your turn"
						hstack
							text "Ship: "
							container [foreground: state.player_colors[loop]]
								hstack
									text state.player_ships[loop]
									text " ("
									text state.player_ship_classnames[loop]
									text ")"
						hstack
							text "Speed: "
							text state.player_speed
							text " / "
							text state.player_max_speeds[loop]
						hstack
							text "Position: "
							text state.player_position_xs[loop]
							text ", "
							text state.player_position_ys[loop]
						hstack
							text "Torpedoes: "
							text state.player_torpedoes_remaining
			@BBHeading [text: "Turn"]
			if state.can_take_turn
				hstack
					text "Speed Change: "
					text state.command_speed_change
					text " -> "
					text state.player_speed + state.command_speed_change
				if state.command_destination_set
					hstack
						text "Flying to: ("
						text state.command_destination_x
						text ", "
						text state.command_destination_y
						text ")"
				hstack
					spacer
					text "Change Speed: "
					@BBButton (click->decrease_speed) [label: "- 1"]
					text " "
					@BBButton (click->reset_speed_change) [label: "0"]
					text " "
					@BBButton (click->increase_speed) [label: "+ 1"]
					spacer
				if state.setting_destination
					@BBButton (click->toggle_set_destination) [label: "Cancel Set Destination"]
				else
					@BBButton (click->toggle_set_destination) [label: "Set Destination"]
				@BBButton (click->submit_command) [label: "Submit Command"]
			else
				text "Command Submitted, waiting for other players"
			@BBHeading [text: "Opponents", padding_top: 1, padding_bottom: 1]
			for player_id in state.player_ids
				if player_id != attributes.player_id
					border
						vstack
							if state.players_ready[loop]
								text [foreground: "green"] "ready"
							else
								text [foreground: "red"] "Still taking their turn"
							hstack
								text state.player_names[loop]
								text ": "
								text [foreground: state.player_colors[loop]] state.player_ships[loop]
								if player_id == state.host_id
									text " Hosting"
							hstack
								text "Ship Class: "
								text state.player_ship_classnames[loop]
							hstack
								text "Max Speed: "
								text state.player_max_speeds[loop]
							hstack
								text "Position: "
								text state.player_position_xs[loop]
								text ", "
								text state.player_position_ys[loop]
